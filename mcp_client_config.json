{
  "mcpServers": {
    "codegraph-brain-docker": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "graphrag_mcp",
        "python",
        "-m",
        "app.mcp_server",
        "--transport",
        "stdio"
      ]
    },
    "codegraph-brain-sse": {
      "url": "http://localhost:8002/sse"
    }
  }
}
