# ============================================================
# Preflight - launch readiness for apps built with AI
# ============================================================

# 1. API Security
API_KEY=
ALLOW_UNAUTHENTICATED=false

# 2. Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_AUTH=none
NEO4J_PASSWORD=none

# 3. Redis Message Broker
REDIS_PASSWORD=ChangeMe_RedisStrongPassword2026!
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# 4. Security Sandbox & Containment Standards
ALLOWED_REPO_DIR=/app/repos
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001
SANDBOX_RUNNER_TOKEN=replace-with-a-long-random-token
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_NANO_CPUS=500000000
SANDBOX_PIDS_LIMIT=64
SANDBOX_MAX_LIFETIME=120
SANDBOX_DOCKER_NETWORK=preflight_sandbox_net
E2B_API_KEY=

# 5. Vultr Serverless Inference Integration
VULTR_API_KEY=
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_MODEL=                     # from GET https://api.vultrinference.com/v1/models (e.g. deepseek-v4.1-flash-1017)
LLM_API_KEY=

# Vultr Supabase Marketplace Integration (Optional Cloud Report Sync)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORT_BUCKET=preflight-reports

# 6. Embedding & Tokenizer
EMBEDDING_API_URL=https://api.vultrinference.com/v1
EMBEDDING_MODEL=qwen3-embedding-4b
EMBEDDING_API_KEY=
EMBEDDING_DIM=1536
ALLOW_FAKE_EMBEDDINGS=true

# 7. Network Port Bindings
WEB_PORT=8001
MCP_PORT=8002

# Optional outbound proxy. Leave empty unless a proxy is actually running.
HTTP_PROXY=
HTTPS_PROXY=
