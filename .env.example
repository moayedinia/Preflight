# ============================================================
# CodeGraph Brain - Enterprise Security & Environment Settings
# ============================================================

# 1. API Security (Unauthenticated mode enabled by default for internal intranet/dev use)
API_KEY=ChangeMe_SecretEnterpriseApiKey2026!
ALLOW_UNAUTHENTICATED=true

# 2. Neo4j Graph Database (Set NEO4J_AUTH=none for intranet use, or neo4j/<password> for auth)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_AUTH=none
NEO4J_PASSWORD=none

# 3. Redis Message Broker
REDIS_PASSWORD=ChangeMe_RedisStrongPassword2026!
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# 4. Security Sandbox & CORS
ALLOWED_REPO_DIR=/app/repos
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 5. AI & Embeddings (Optional: Insert OpenAI API Key)
OPENAI_API_KEY=

# 6. Corporate / Internal Mirrors (IME Network)
# Docker Hub registry mirror: MUST NOT contain https:// or http:// and MUST end with a trailing slash /
# Correct: dockerhub.ime.co.ir/    (Wrong: https://dockerhub.ime.co.ir)
DOCKER_REGISTRY=dockerhub.ime.co.ir/
# PyPI internal mirror repository for Python packages
PYPI_MIRROR=https://pypi.repo.ime.co.ir/repository/pypi-group/simple/
PYPI_HOST=pypi.repo.ime.co.ir
# Debian Linux APT mirror repository for OS packages (apt-get)
DEBIAN_MIRROR=https://linux.repo.ime.co.ir/repository/debian

# 7. Local HuggingFace Embeddings
# HuggingFace will cache models in the ./models directory
HF_HOME=/app/models
# Embedding model tag from HuggingFace
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code

# Embedding vector dimensions (768 for Jina v2 code, 1024 for Jina v3 / bge-m3, 1536 for OpenAI)
EMBEDDING_DIM=768

# Optional: LLM Chat Model on Ollama for GraphRAG answers & PR review (e.g. qwen2.5-coder, llama3)
LLM_MODEL=

# 8. Network Port Bindings (Exposing strictly two external ports)
# Port 8001: Web Dashboard & Full API (User Interface, Swagger Docs, Ingestion)
WEB_PORT=8001
# Port 8002: Model Context Protocol (MCP) Server for AI Agents (Cursor, Claude Desktop, etc.)
MCP_PORT=8002

