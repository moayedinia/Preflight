# ============================================================
# CodeGraph Brain - Enterprise Security & Environment Settings
# ============================================================

# 1. API Security (Generate a strong secret key for enterprise access)
API_KEY=ChangeMe_SecretEnterpriseApiKey2026!
ALLOW_UNAUTHENTICATED=false

# 2. Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ChangeMe_Neo4jStrongPassword2026!

# 3. Redis Message Broker
REDIS_PASSWORD=ChangeMe_RedisStrongPassword2026!
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# 4. Security Sandbox & CORS
ALLOWED_REPO_DIR=/app/repos
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 5. AI & Embeddings (Optional: Insert OpenAI API Key)
OPENAI_API_KEY=

# 6. Corporate / Internal Mirrors (IME Network)
# Docker Hub registry mirror (e.g. dockerhub.ime.co.ir/ or leave empty if configured in daemon.json)
DOCKER_REGISTRY=dockerhub.ime.co.ir/
# PyPI internal mirror repository for Python packages
PYPI_MIRROR=https://pypi.repo.ime.co.ir/repository/pypi-group/simple
PYPI_HOST=pypi.repo.ime.co.ir

# 7. Local / Internal Ollama & Jina Embeddings
# URL of Ollama instance (http://host.docker.internal:11434 if running on host, or IP of corporate Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Embedding model name tag in Ollama (e.g. jina-embeddings-v2-base-code, nomic-embed-text)
EMBEDDING_MODEL=jina-embeddings-v2-base-code
# Embedding vector dimensions (768 for Jina v2, 1024 for Jina v3 / bge-m3, 1536 for OpenAI)
EMBEDDING_DIM=768
