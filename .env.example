# ============================================================
# ShipCheck - Code Quality & Preflight for Vibe Coders
# ============================================================

# 1. API Security (Unauthenticated mode enabled by default for local/dev use)
API_KEY=
ALLOW_UNAUTHENTICATED=true

# 2. Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_AUTH=none
NEO4J_PASSWORD=none

# 3. Redis Message Broker
REDIS_PASSWORD=ChangeMe_RedisStrongPassword2026!
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# 4. Security Sandbox & CORS
ALLOWED_REPO_DIR=/app/repos
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001
SANDBOX_RUNNER_TOKEN=replace-with-a-long-random-token
SANDBOX_MEMORY_LIMIT=768m
SANDBOX_NANO_CPUS=1000000000
SANDBOX_PIDS_LIMIT=256

# 5. AI Configuration (OpenAI, OpenRouter, Groq, Ollama, etc.)
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# 6. Embedding & Tokenizer (Uses standard OpenAI-compatible API or fallback)
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIM=1536
ALLOW_FAKE_EMBEDDINGS=true

# 7. Network Port Bindings
WEB_PORT=8001
MCP_PORT=8002

# Optional build/runtime proxy. Leave empty unless a proxy is actually running.
HTTP_PROXY=
HTTPS_PROXY=
