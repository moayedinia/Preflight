# ============================================================
# Preflight - launch readiness for apps built with AI
# ============================================================

# 1. API Security
API_KEY=
ALLOW_UNAUTHENTICATED=false

# 2. Security Sandbox & Blast Radius Zero Containment (Challenge 1)
ALLOWED_REPO_DIR=/app/repos
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001
SANDBOX_RUNNER_TOKEN=replace-with-a-long-random-token
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_NANO_CPUS=1000000000
SANDBOX_PIDS_LIMIT=128
SANDBOX_MAX_LIFETIME=900
SANDBOX_DOCKER_NETWORK=preflight_sandbox_net
E2B_API_KEY=

# 3. AI Configuration (Vultr Serverless Inference - Challenge 1 Mandatory)
VULTR_API_KEY=
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_API_KEY=
# Alternative: Direct OpenAI (if using OpenAI keys)
OPENAI_API_KEY=

# 4. Embedding & Tokenizer (Uses standard Vultr Inference / OpenAI compatible endpoint)
EMBEDDING_API_URL=https://api.vultrinference.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIM=1536
ALLOW_FAKE_EMBEDDINGS=true

# 5. Network Port Bindings
WEB_PORT=8001
API_PORT=8000

# 6. Optional build/runtime proxy. Leave empty unless a proxy is actually running.
HTTP_PROXY=
HTTPS_PROXY=
